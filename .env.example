# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# Job Finder Pro – Powered by IAMTECHNI
# ==========================================
PORT=3000
NODE_ENV="development"

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/jobfinderpro?schema=public"

# Redis Caching & Queue
REDIS_URL="redis://localhost:6379"

# Administrator Authentication & Intake Email
ADMIN_EMAIL="admin@iamtechni.com"
ADMIN_PASSWORD="IAMTECHNI2026!Admin"

# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_ANDROID_CLIENT_ID="your-android-client-id.apps.googleusercontent.com"

# SMTP Email Dispatch for Inbound Employer Requests
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-smtp-api-key"
EMAIL_FROM="Job Finder Pro <notifications@iamtechni.com>"

